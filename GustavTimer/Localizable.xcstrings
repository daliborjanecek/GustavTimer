    "PT_5MIN_MEDITATION" : {
      "comment" : "Name of a predefined timer that is a 5-minute meditation session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meditace 5 min"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5min Meditation"
          }
        }
      }
    },
    "PT_5MIN_MEDITATION_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkus dýchání do čtverce. Nadechuj se, zadrž dech, vydechuj a znovu zadrž dech. Každá fáze trvá 4 sekundy. Když ti myšlenky utečou jinam, vrať pozornost k dechu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try box breathing. Inhale, hold, exhale and hold again. Give each step 4 seconds. If your mind wanders, bring your attention back to your breath."
          }
        }
      }
    },
    "PT_5MIN_MEDITATION_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehni si na záda a pomalu vnímej celé tělo od chodidel až po temeno hlavy. U každé části se na chvíli zastav a vědomě ji uvolni."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lie on your back and slowly scan your body from your feet to the top of your head. Pause as you focus on each part, then let it relax."
          }
        }
      }
    },
    "PT_5MIN_MEDITATION_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Představ si nadcházející trénink od začátku do konce. Pomůže ti to se na něj soustředit a můžeš si tím zlepšit i výkon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picture your upcoming workout from start to finish. It can help you focus and may improve your performance."
          }
        }
      }
    },
    "PT_AMRAP" : {
      "comment" : "Name of a predefined timer where the user can set as many rounds as possible.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMRAP 20 minut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20-minute AMRAP"
          }
        }
      }
    },
    "PT_AMRAP_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělej 5 shybů, 10 kliků a 15 dřepů. Takhle vypadá jedno kolo klasického crossfitového tréninku Cindy. Za 20 minut zvládni co nejvíc kol."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do 5 pull-ups, 10 push-ups and 15 squats. That’s one round of Cindy, a classic CrossFit benchmark workout. Complete as many rounds as you can in 20 minutes."
          }
        }
      }
    },
    "PT_AMRAP_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V každém kole udělej 10 švihů s kettlebellem, 10 sedů-lehů a 10 výpadů. Zapojíš celé tělo. Zvládni co nejvíc kol za 20 minut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In each round, do 10 kettlebell swings, 10 sit-ups and 10 lunges. You’ll work your whole body. Complete as many rounds as you can in 20 minutes."
          }
        }
      }
    },
    "PT_AMRAP_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V každém kole udělej 8 angličáků, 12 výskoků na bednu a 16 střídavých přítahů kolen v prkně. Zvládni co nejvíc kol za 20 minut. Tahle náročnější varianta prověří tvoji výbušnost i výdrž."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In each round, do 8 burpees, 12 box jumps and 16 mountain climbers. Complete as many rounds as you can in 20 minutes. This tougher version tests your explosive power and endurance."
          }
        }
      }
    },
    "PT_EMOM_10MIN" : {
      "comment" : "Name of a 10-minute EMOM timer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EMOM 10 minut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10-minute EMOM"
          }
        }
      }
    },
    "PT_EMOM_10MIN_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každou minutu udělej 10 kliků. Čím rychleji je zvládneš, tím víc času ti zbude na odpočinek. Jestli je to pro tebe snadné, přidej klik s tlesknutím."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do 10 push-ups every minute. The faster you finish, the longer you have to rest. If it feels easy, add a clap push-up."
          }
        }
      }
    },
    "PT_EMOM_10MIN_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každou minutu udělej 15 dřepů. Za celý trénink jich tak zvládneš 150. Zní to jednoduše, ale tolik opakování ti dá zabrat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do 15 squats every minute. That’s 150 squats in one workout. It sounds simple, but that many reps will challenge you."
          }
        }
      }
    },
    "PT_EMOM_10MIN_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V lichých minutách dělej shyby na hrazdě, v sudých kliky na bradlech. Procvičíš tak horní část těla."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do pull-ups on the odd minutes and parallel bar dips on the even minutes. You’ll work your upper body."
          }
        }
      }
    },
    "PT_HIIT" : {
      "comment" : "Name of a predefined timer that follows the HIIT (High-Intensity Interval Training) method.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIIT 30/15"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIIT 30/15"
          }
        }
      }
    },
    "PT_HIIT_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dělej výbušné švihy s kettlebellem 30 sekund a pak 15 sekund odpočívej. Zopakuj to desetkrát. Zapojíš celé tělo, hlavně hýždě a zadní stranu stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do explosive kettlebell swings for 30 seconds, then rest for 15 seconds. Repeat for 10 rounds. You’ll work your whole body, especially your glutes and hamstrings."
          }
        }
      }
    },
    "PT_HIIT_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyskakuj na bednu 30 sekund naplno a pak 15 sekund odpočívej. Tep ti rychle stoupne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do box jumps at full effort for 30 seconds, then rest for 15 seconds. Your heart rate will rise quickly."
          }
        }
      }
    },
    "PT_HIIT_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běž 30 sekund na místě naplno a kolena zvedej vysoko. Pak 15 sekund vydrž v prkně."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do high knees in place at full effort for 30 seconds, then hold a plank for 15 seconds."
          }
        }
      }
    },
    "PT_TABATA" : {
      "comment" : "Name of a predefined timer that follows the Tabata routine.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabata 20/10"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabata 20/10"
          }
        }
      }
    },
    "PT_TABATA_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za 20 sekund udělej co nejvíc angličáků a pak 10 sekund odpočívej. Ke konci by ti to mělo dát zabrat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do as many burpees as you can in 20 seconds, then rest for 10 seconds. The last few rounds should feel tough."
          }
        }
      }
    },
    "PT_TABATA_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyskakuj ze dřepu 20 sekund a pak 10 sekund odpočívej. U každého skoku se soustřeď na co největší výšku."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do squat jumps for 20 seconds, then rest for 10 seconds. Focus on jumping as high as you can on each rep."
          }
        }
      }
    },
    "PT_TABATA_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve vysokém prkně 20 sekund co nejrychleji střídej přítahy kolen k hrudníku. Pak 10 sekund odpočívej. Zapojíš střed těla a zvedneš si tep."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do mountain climbers in a high plank for 20 seconds, then rest for 10 seconds. Move as quickly as you can to work your core and raise your heart rate."
          }
        }
      }
    },
