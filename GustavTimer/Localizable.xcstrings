    "PT_5MIN_MEDITATION" : {
      "comment" : "Name of a predefined timer that is a 5-minute meditation session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meditace 5 minut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meditation 5mins"
          }
        }
      }
    },
    "PT_5MIN_MEDITATION_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Box breathing, soustřeď se výhradně na dech (4-4-4-4: nádech, zadržení, výdech, zadržení). Kdykoli myšlenky odjedou jinam, jednoduše je vrátíš zpět k dechu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box breathing – focus exclusively on your breath (4-4-4-4: inhale, hold, exhale, hold). Whenever your thoughts wander, simply bring them back to your breath."
          }
        }
      }
    },
    "PT_5MIN_MEDITATION_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lehni si na záda, a pomalu procházej svojí pozorností celé tělo od chodidel po temeno hlavy. U každé části se zastav a vědomě ji uvolni."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lie on your back and slowly scan your entire body with your attention from your feet to the top of your head. At each part, pause and consciously release it."
          }
        }
      }
    },
    "PT_5MIN_MEDITATION_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "V hlavě si přehraj celý nadcházející trénink. Pomáhá to mentálně se naladit a podle výzkumů i zlepšuje reálný výkon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play through your entire upcoming workout in your head. It helps you mentally tune in and according to research it also improves real performance."
          }
        }
      }
    },
    "PT_AMRAP" : {
      "comment" : "Name of a predefined timer where the user can set as many rounds as possible.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMRAP 20 minut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20mins AMRAP"
          }
        }
      }
    },
    "PT_AMRAP_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 pull-ups, 10 kliků, 15 dřepů – klasický CrossFit benchmark \"Cindy\". Snaž se zvládnout co nejvíce kol za 20 minut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 pull-ups, 10 push-ups, 15 squats – the classic CrossFit benchmark \"Cindy\". Try to complete as many rounds as possible in 20 minutes."
          }
        }
      }
    },
    "PT_AMRAP_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 kettlebell swings, 10 sit-ups, 10 výpadů – vyvážené kolo zapojující celé tělo, vhodné pro všechny úrovně. Udělej jich co nejvíce. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 20 minutes complete as maty rounds as possible: 10 kettlebell swings, 10 sit-ups, 10 lunges – a balanced round engaging the whole body, suitable for all levels."
          }
        }
      }
    },
    "PT_AMRAP_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve 20 minutách udělej co nejvíce kol: 8 burpees, 12 box jumps, 16 mountain climbers – náročnější varianta s důrazem na výbušnost a kardio výdrž."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 burpees, 12 box jumps, 16 mountain climbers – a more demanding variation with emphasis on explosiveness and cardio endurance. Do as many rounds as you can. "
          }
        }
      }
    },
    "PT_EMOM_10MIN" : {
      "comment" : "Name of a 10-minute EMOM timer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EMOM 10 minut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EMOM 10mins"
          }
        }
      }
    },
    "PT_EMOM_10MIN_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každou minutu udělej 10 kliků – čím rychleji je zvládneš, tím více odpočinku v minutě získáš. Pokud ti to přijde lehké, přidej klik s tlesknutím."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do 10 push-ups every minute – the faster you complete them, the more rest you get within the minute. If it feels easy, add a clap push-up."
          }
        }
      }
    },
    "PT_EMOM_10MIN_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každou minutu udělej 15 dřepů – celkem 150 dřepů za trénink. Jednoduché na první pohled, ale překvapivě náročné."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do 15 squats every minute – a total of 150 squats per workout. Simple at first glance, but a surprisingly demanding volume."
          }
        }
      }
    },
    "PT_EMOM_10MIN_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Střídej pull-ups a dipy – v liché minutě přítahy na hrazdě, v sudé minutě dipy na bradlech. Komplexní trénink horní části těla."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate pull-ups and dips – odd minutes pull-ups on the bar, even minutes dips on parallel bars. A comprehensive upper body workout."
          }
        }
      }
    },
    "PT_HIIT" : {
      "comment" : "Name of a predefined timer that follows the HIIT (High-Intensity Interval Training) method.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIIT 30/15"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIIT 30/15"
          }
        }
      }
    },
    "PT_HIIT_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "30 sekund dělej kettlebell swing co nejexplosivněji, pak 15 sekund odpočívej. Skvělý cvik pro celkovou kondici."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kettlebell swings – an explosive exercise engaging the whole body with emphasis on the posterior chain. Do 10 rounds with 15 seconds of rest between them."
          }
        }
      }
    },
    "PT_HIIT_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "30 sekund vyskakuj na bednu s maximálním úsilím, pak 15 sekund odpočívej. Tepová frekvence půjde rychle nahoru."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump onto a box and develop explosive power. Your heart rate will go up fast."
          }
        }
      }
    },
    "PT_HIIT_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "30 sekund sprintuj na místě v maximální intenzitě, pak 15 sekund drž plank."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate high knees and plank – 30 seconds of maximum cardio effort, 15 seconds of static hold in a plank."
          }
        }
      }
    },
    "PT_TABATA" : {
      "comment" : "Name of a predefined timer that follows the Tabata routine.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabata 20/10"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabata 20/10"
          }
        }
      }
    },
    "PT_TABATA_TIP1" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dobu 20 sekund dělej co nejvíce burpees, pak 10 sekund odpočívej. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do as many burpees as you can for 20 seconds, then rest for 10 seconds. It should be really hard by the end."
          }
        }
      }
    },
    "PT_TABATA_TIP2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 sekund vyskakuj ze dřepu co nejvýše, pak 10 sekund odpočívej. Důraz dej na maximální výšku skoku, ne na rychlost."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explode out of the squat and jump as high as you can for 20 seconds, then rest for 10 seconds. Focus on maximum height, not speed."
          }
        }
      }
    },
    "PT_TABATA_TIP3" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mountain climbers – 20 sekund běž ve vysokém prknu v maximálním tempu, pak 10 sekund odpočívej. Skvělá kombinace core tréninku a kardio zátěže."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mountain climbers – run in a high plank at maximum pace for 20 seconds, then rest for 10 seconds. A great combination of core training and cardio."
          }
        }
      }
    },
