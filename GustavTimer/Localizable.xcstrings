    "OB_GUSTAV_DESCRIPTION" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gustav Frištenský byl slavný český zápasník a symbol síly i vytrvalosti. Jeho jméno tu bereme jako připomínku: síla je hlavně o disciplíně a pravidelnosti."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gustav Frištenský was a famous Czech wrestler and a symbol of strength and endurance. We use his name as a reminder: real strength is built through discipline and consistency."
          }
        }
      }
    },
    "OB_GUSTAV_TITLE" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proč Gustav?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why Gustav?"
          }
        }
      }
    },
    "OB_TIMER_DESCRIPTION" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskládej si vlastní intervaly, pauzy a opakování. Každý blok si můžeš pojmenovat, nastavit opakování a upozornění."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build your own intervals, breaks, and repetitions. Name each block and set its repeats and notifications."
          }
        }
      }
    },
    "OB_TIMER_TITLE" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
