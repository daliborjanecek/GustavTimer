    "OB_TIMER_DESCRIPTION" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskládej si vlastní intervaly a pauzy. Pojmenuj si každý interval, nastav počet kol, zvuk a vibrace."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up your own intervals and breaks. Name each interval, set the number of rounds and choose your sound and vibration settings."
          }
