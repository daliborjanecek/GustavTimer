    "OB_GUSTAV_DESCRIPTION" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gustav Frištenský byl slavný český zápasník a symbol síly i vytrvalosti. Jeho jméno připomíná, že sílu buduješ disciplínou a pravidelností."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gustav Frištenský was a famous Czech wrestler and a symbol of strength and endurance. His name is a reminder that you build strength through discipline and consistency."
          }
        }
      }
    },
    "OB_GUSTAV_TITLE" : {
